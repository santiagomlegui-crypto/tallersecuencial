Algoritmo mediaTres
	Definir datoA, datoB, datoC, mediaCalculada Como Real
	Escribir "digite el primer numero"
	Leer datoA
	Escribir "digite el segundo numero"
	Leer datoB
	Escribir "digite el tercer numero"
	Leer datoC
	mediaCalculada = (datoA + datoB + datoC) / 3
	Escribir "El promedio aritmetico es: ", mediaCalculada
FinAlgoritmo
