Algoritmo dosYtres
	Definir datoBase, valorDoble, valorTriple Como Real
	Escribir "Digite el numero a operar"
	Leer datoBase
	valorDoble = datoBase * 2
	valorTriple = datoBase * 3
	Escribir "El doble del numero es: ", valorDoble
	Escribir "El triple del numero es: ", valorTriple
FinAlgoritmo
