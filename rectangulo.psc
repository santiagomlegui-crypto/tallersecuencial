Algoritmo rectangulo
	Definir medidaHorizontal, medidaVertical, resultadoArea, resultadoPerimetro Como Real
	Escribir "Digite la base del triangulo"
	Leer medidaHorizontal
	Escribir "Digite la altura del triangulo"
	Leer medidaVertical
	resultadoArea = medidaHorizontal * medidaVertical
	resultadoPerimetro = (medidaHorizontal + medidaVertical) * 2
	Escribir "El area del rectangulo es: ", resultadoArea
	Escribir "El perimetro del rectangulo es: ", resultadoPerimetro
FinAlgoritmo