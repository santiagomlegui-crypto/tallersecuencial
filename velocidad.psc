Algoritmo velocidad
	Definir trayecto, duracion, resultadoVelocidad Como Real
	Escribir "ingresas tu distancia (km)"
	Leer trayecto
	Escribir "ingresas tu tiempo (h)"
	Leer duracion
	resultadoVelocidad = trayecto / duracion
	Escribir "tu velocidad es: (km/h) ", resultadoVelocidad
FinAlgoritmo