Algoritmo teoremaTriangulo
	Definir ladoMenorA, ladoMenorB, ladoMayorC Como Real
	Escribir "Digite el primer cateto"
	Leer ladoMenorA
	Escribir "Digite el segundo cateto"
	Leer ladoMenorB
	ladoMayorC = rc(ladoMenorA ^ 2 + ladoMenorB ^ 2)
	Escribir "la hipotenusa del triangulo rectangulo es: ", ladoMayorC
FinAlgoritmo
