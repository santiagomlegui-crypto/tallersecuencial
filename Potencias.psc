Algoritmo Potencias
	Definir valorBase, potenciaCuadrada, potenciaCubica Como Real
	Escribir "Digite el numero a operar"
	Leer valorBase
	potenciaCuadrada = valorBase ^ 2
	potenciaCubica = valorBase ^ 3
	Escribir "El cuadrado del numero es: ", potenciaCuadrada
	Escribir "El cubo del numero es: ", potenciaCubica
FinAlgoritmo