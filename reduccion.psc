Algoritmo reduccion
	Definir cantidadOriginal, valorDescuento, cantidadReducida Como Real
	cantidadOriginal = Aleatorio(10,50)	
	Escribir "El numero aleatorio es: ", cantidadOriginal
	valorDescuento = cantidadOriginal * 0.15
	cantidadReducida = cantidadOriginal - valorDescuento
	Escribir "El numero aleatorio disminuido 15 % es: ", cantidadReducida
FinAlgoritmo
