Algoritmo pagoEmpleado
	Definir horasRegistradas, costoHora, pagoCalculado Como Real
	Escribir "ingrese el numero de horas laboradas"
	Leer horasRegistradas
	Escribir "ingrese el valor por hora"
	Leer costoHora
	pagoCalculado = horasRegistradas * costoHora
	Escribir "El salario por pagar es: ", pagoCalculado
FinAlgoritmo
