Algoritmo sin_titulo
	Definir num,raizz , seno , coseno , tangente ,logaritmoNatural ,logaritmo10 Como Real
	Escribir "digite el numero a operar"
	leer num
	seno = sen(num)
	coseno = cos(num)
	tangente = tan(num)
	raizz = rc(num)
	logaritmoNatural = ln(num)
	logaritmo10 = ln(num)/ln(10)
	Escribir "el seno del numero es: " , seno
	Escribir "el coseno del numero es : " , coseno 
	Escribir "la tangente del numero es : " , tangente
	Escribir "la raiz cuadrada del numero es : " , raizz
	Escribir "el algoritno natural del numero es : ", logaritmoNatural
	Escribir " el algoritmo natural del numero es :" , logaritmo10
FinAlgoritmo
