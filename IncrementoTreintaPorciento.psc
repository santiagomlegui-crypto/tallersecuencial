Algoritmo IncrementoTreintaPorciento
	Definir datoInicial, parteExtra, montoFinal Como Real
	datoInicial = Aleatorio(0,200)
	Escribir "El numero aleatorio es: ", datoInicial
	parteExtra = datoInicial * 0.3
	montoFinal = parteExtra + datoInicial
	Escribir "El numero aleatorio aumentado 30% es: ", montoFinal
FinAlgoritmo