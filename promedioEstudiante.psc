Algoritmo promedioEstudiante
	Definir calificacionUno, calificacionDos, calificacionTres, calificacionCuatro, resultadoPromedio Como Real
	Escribir "Digite la primera nota del estudiante"
	Leer calificacionUno
	Escribir "Digite la segunda nota del estudiante"
	Leer calificacionDos
	Escribir "Digite la tercera nota del estudiante"
	Leer calificacionTres
	Escribir "Digite la cuarta nota del estudiante"
	Leer calificacionCuatro
	resultadoPromedio = (calificacionUno + calificacionDos + calificacionTres + calificacionCuatro) / 4
	Escribir "El promedio final del estudiante es: ", resultadoPromedio
FinAlgoritmo
